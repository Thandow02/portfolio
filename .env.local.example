# ─── Sentry Error Monitoring ───────────────────────────────────────────────────
# Your Sentry DSN — find it at: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=

# Sentry org slug and project name (only needed for source-map uploads during build)
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry auth token for uploading source maps (generate at https://sentry.io/settings/auth-tokens/)
# Add this to your Vercel environment variables — do NOT commit it here
SENTRY_AUTH_TOKEN=
